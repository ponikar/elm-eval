# ─── Web App ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Pipeline HTTP Gateway ─────────────────────────────────
# URL of the pipeline server's POST /run/:runId endpoint (e.g. http://your-vps:3210)
PIPELINE_URL=
# Shared secret for x-pipeline-secret header authentication
PIPELINE_SECRET=

# ─── Pipeline Server (run from Hetzner VPS) ────────────────
# DATABASE_URL is shared with the web app (same Neon Postgres)
# PIPELINE_SECRET must match the web app's PIPELINE_SECRET
